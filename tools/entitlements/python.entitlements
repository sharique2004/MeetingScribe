<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for the bundled CPython interpreter and any
     Mach-O helper that runs Python code.

     - audio-input: sounddevice/CoreAudio capture runs in the Python process;
       hardened runtime denies the mic without this, even after TCC consent.
     - allow-unsigned-executable-memory: libffi/ctypes trampolines (and some
       wheels) need W+X pages; hardened runtime forbids them otherwise.
     - allow-jit: numba/llvmlite (mlx_whisper word timestamps) allocate
       executable memory via mmap(MAP_JIT), which the previous key does not
       cover; python.org signs CPython with both keys for the same reason.
     - disable-library-validation: every bundled .so/.dylib is re-signed with
       our identity, but wheels occasionally dlopen caches or vendor-signed
       blobs; without this a single mismatched dylib aborts the interpreter. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
