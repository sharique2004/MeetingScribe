<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>MeetingScribe</string>
	<key>CFBundleExecutable</key>
	<string>MeetingScribe</string>
	<key>CFBundleIdentifier</key>
	<string>com.meetingscribe.ios</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MeetingScribe</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>26.0</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Mandatory. Touching the microphone without this key does not fail,
	     it crashes the app on the spot. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>MeetingScribe records the room so it can transcribe and summarise your meeting on this iPhone. The audio never leaves the device.</string>
	<!-- The entitlement half of background recording. Without it the mic dies
	     the moment the screen locks; with it, and an active .playAndRecord
	     session, capture survives a locked phone for the whole meeting. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
